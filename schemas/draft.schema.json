{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sriram-advisory:linkedin-formatter:draft:1",
  "title": "LinkedIn Text Formatter draft v1", "$ref": "#/$defs/draft",
  "$comment": "Runtime validation also caps aggregate source text at 20000 UTF-16 units and enforces mark uniqueness and mutually exclusive overlays.",
  "$defs": {
    "preferences": { "type": "object", "additionalProperties": false, "properties": { "theme": { "enum": ["light", "dark"] }, "guidance": { "type": "boolean" }, "dismissedIntro": { "type": "boolean" } } },
    "mark": { "oneOf": [ { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "enum": ["bold", "italic", "underline", "strike"] } } }, { "type": "object", "required": ["type", "attrs"], "additionalProperties": false, "properties": { "type": { "const": "family" }, "attrs": { "type": "object", "required": ["family"], "additionalProperties": false, "properties": { "family": { "enum": ["sans", "serif"] } } } } } ] },
    "inline": { "oneOf": [ { "type": "object", "required": ["type", "text"], "additionalProperties": false, "properties": { "type": { "const": "text" }, "text": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" }, "marks": { "type": "array", "items": { "$ref": "#/$defs/mark" }, "maxItems": 4 } } }, { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "hardBreak" } } } ] },
    "paragraph": { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "paragraph" }, "attrs": { "type": "object", "additionalProperties": false, "properties": { "listType": { "enum": [null, "hyphen", "bullet", "number"] } } }, "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } } } },
    "doc": { "type": "object", "required": ["type", "content"], "additionalProperties": false, "properties": { "type": { "const": "doc" }, "content": { "type": "array", "minItems": 1, "maxItems": 20001, "items": { "$ref": "#/$defs/paragraph" } } } },
    "draft": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "title", "createdAt", "updatedAt", "revision", "editorDocument", "preferences"], "properties": { "schemaVersion": { "const": 1 }, "id": { "type": "string", "minLength": 1, "maxLength": 100 }, "title": { "type": "string", "minLength": 1, "maxLength": 200 }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "revision": { "type": "integer", "minimum": 0 }, "editorDocument": { "$ref": "#/$defs/doc" }, "preferences": { "$ref": "#/$defs/preferences" } } }
  }
}
